# Backend project only. Never use NEXT_PUBLIC_ names for secrets.
ENVIRONMENT=production
APP_URL=https://authorise.vaedoc.com
# MySQL: use a dedicated database and restricted user; URL-encode credentials.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/vaedoc_authorise
DB_REQUIRE_TLS=true
# For a private CA, provide the PEM certificate through the environment.
# DB_CA_CERT_PEM=
# Alternative: Neon PostgreSQL pooled URL (driver is normalised automatically)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME
