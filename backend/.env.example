# Backend project only. Never use NEXT_PUBLIC_ names for secrets.
ENVIRONMENT=production
APP_URL=https://authorise.vaedoc.com
# Selected deployment: Neon PostgreSQL Free. Use Neon's pooled connection URL.
# Both postgresql:// and postgresql+psycopg:// are accepted by the backend.
# Keep the real connection string in the backend Vercel project's environment only.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLED_HOST/DBNAME
DB_REQUIRE_TLS=true
# For a private CA, provide the PEM certificate through the environment.
# DB_CA_CERT_PEM=
# MySQL remains supported if needed later:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/vaedoc_authorise
